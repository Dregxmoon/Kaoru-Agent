# ── Dependencias y build ─────────────────────────────────────────────────────
node_modules/
dist/

# ── Configuración sensible (nunca se sube) ───────────────────────────────────
# La config real de cada máquina vive en %APPDATA% / ~/.config/vtuber-overlay/
*.env
!*.env.example
config.json
.march7th/

# ── Bases de datos locales (memoria/sesiones del usuario) ────────────────────
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

# ── Modelos de voz (se descargan automáticamente) ────────────────────────────
models/vosk-es/

# ── Datos personales y exportaciones de conversación ─────────────────────────
exports/
test.txt

# ── Artefactos de desarrollo y parches one-off ───────────────────────────────
*.patch
*.orig
*.rej
tests/prueba_vivo_*.js

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo

# ── Sistema operativo / editores ─────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
