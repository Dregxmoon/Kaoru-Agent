{
  "name": "vtuber-overlay",
  "version": "1.0.0",
  "description": "Overlay VTuber Live2D siempre encima de otras ventanas",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "postinstall": "node fix-electron.js",
    "build": "electron-builder --win --x64",
    "build-portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "electron-rebuild": "^3.2.9"
  },
  "build": {
    "appId": "com.vtuber.overlay",
    "productName": "VTuber Overlay",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "files": [
      "main.js",
      "src/**/*",
      "assets/**/*",
      "models/**/*",
      "Models/**/*"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^12.10.0",
    "playwright": "^1.61.0",
    "sqlite-vec": "^0.1.9"
  }
}
