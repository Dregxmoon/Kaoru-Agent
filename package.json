{
  "name": "vtuber-overlay",
  "version": "1.0.0",
  "description": "Overlay VTuber Live2D siempre encima de otras ventanas",
  "main": "main.js",
  "bin": {
    "asistente": "./bin/asistente.js"
  },
  "license": "MIT",
  "scripts": {
    "start": "ELECTRON_DISABLE_SECURITY_WARNINGS=1 electron . 2>&1 | grep -vE 'Fontconfig warning|invalid (attribute|constant used)'",
    "postinstall": "node fix-electron.js",
    "rebuild": "npx @electron/rebuild -f -w better-sqlite3",
    "build": "electron-builder --win --x64",
    "build-portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.vtuber.overlay",
    "productName": "VTuber Overlay",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "files": [
      "main.js",
      "src/**/*",
      "assets/**/*",
      "models/**/*",
      "Models/**/*"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^11.0.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.12",
    "dotenv": "^17.4.2",
    "marked": "^9.1.6",
    "playwright": "^1.61.0",
    "sqlite-vec": "^0.1.9"
  }
}
