{
  "name": "asistente-personal",
  "version": "1.0.0",
  "description": "Asistente personal de escritorio con avatar Live2D, memoria y proactividad",
  "main": "main.js",
  "bin": {
    "asistente": "./bin/asistente.js"
  },
  "license": "MIT",
  "scripts": {
    "start": "ELECTRON_DISABLE_SECURITY_WARNINGS=1 electron . 2>&1 | grep -vE 'Fontconfig warning|invalid (attribute|constant used)'",
    "postinstall": "node fix-electron.js && node scripts/link-asistente.js",
    "rebuild": "npx @electron/rebuild -f -w better-sqlite3",
    "test": "bash tests/run-all.sh",
    "coverage": "bash scripts/coverage.sh",
    "coverage:check": "bash scripts/coverage.sh --check",
    "lint": "eslint main.js openclaw-server.js core infrastructure ipc tests benchmarks src --ext .js",
    "lint:fix": "eslint --fix main.js openclaw-server.js core infrastructure ipc tests benchmarks src --ext .js",
    "format": "prettier --write \"main.js\" \"openclaw-server.js\" \"{core,infrastructure,ipc,tests,benchmarks,src}/**/*.js\"",
    "format:check": "prettier --check \"main.js\" \"openclaw-server.js\" \"{core,infrastructure,ipc,tests,benchmarks,src}/**/*.js\"",
    "typecheck": "tsc --noEmit",
    "cli": "ELECTRON_RUN_AS_NODE=1 electron bin/cli.js",
    "cli:help": "ELECTRON_RUN_AS_NODE=1 electron bin/cli.js help",
    "bench": "node benchmarks/run.js",
    "bench:one": "node benchmarks/run.js rename-multiply",
    "bench:summary": "node benchmarks/summary.js",
    "build": "electron-builder --win --x64",
    "build-portable": "electron-builder --win portable",
    "build:win": "electron-builder --win --x64",
    "build:mac": "electron-builder --mac --x64 --arm64",
    "build:linux": "electron-builder --linux --x64",
    "build:all": "electron-builder --win --x64 && electron-builder --mac --x64 --arm64 && electron-builder --linux --x64",
    "publish:win": "electron-builder --win --x64 --publish always",
    "publish:mac": "electron-builder --mac --x64 --arm64 --publish always",
    "publish:linux": "electron-builder --linux --x64 --publish always"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/node": "^26.1.2",
    "c8": "^12.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.0",
    "prettier": "^3.3.0",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.asistente.personal",
    "productName": "Asistente Personal",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "Dregxmoon",
      "repo": "Kaoru-Agent",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "identity": null
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "maintainer": "Dregxmoon"
    },
    "files": [
      "main.js",
      "openclaw-server.js",
      "updater.js",
      "bin/**/*",
      "core/**/*",
      "infrastructure/**/*",
      "ipc/**/*",
      "plugins/**/*",
      "src/**/*",
      "assets/**/*",
      "models/**/*",
      "Models/**/*",
      "!data/**/*",
      "!tests/**/*",
      "!benchmarks/**/*"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^11.0.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.12",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "marked": "^9.1.6",
    "mermaid": "^11.4.1",
    "minimatch": "^10.2.0",
    "onnxruntime-node": "^1.14.0",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^6.5.10",
    "playwright": "^1.61.0",
    "sqlite-vec": "^0.1.9"
  },
  "overrides": {
    "pixi-live2d-display": {
      "gh-pages": "^5.0.0"
    },
    "@xenova/transformers": {
      "sharp": "^0.33.5",
      "onnxruntime-web": {
        "onnx-proto": {
          "protobufjs": "^7.6.3"
        }
      }
    }
  },
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  }
}