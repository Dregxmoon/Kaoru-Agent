{
  "name": "asistente-personal",
  "version": "1.0.0",
  "description": "Asistente personal de escritorio con avatar Live2D, memoria y proactividad",
  "main": "main.js",
  "bin": {
    "asistente": "./bin/asistente.js"
  },
  "license": "MIT",
  "scripts": {
    "start": "ELECTRON_DISABLE_SECURITY_WARNINGS=1 electron . 2>&1 | grep -vE 'Fontconfig warning|invalid (attribute|constant used)'",
    "postinstall": "node fix-electron.js",
    "rebuild": "npx @electron/rebuild -f -w better-sqlite3",
    "test": "bash tests/run-all.sh",
    "lint": "eslint main.js openclaw-server.js core infrastructure ipc tests benchmarks src --ext .js",
    "lint:fix": "eslint --fix main.js openclaw-server.js core infrastructure ipc tests benchmarks src --ext .js",
    "format": "prettier --write \"{main.js,openclaw-server.js,core,infrastructure,ipc,tests,benchmarks,src}/**/*.js\"",
    "format:check": "prettier --check \"{main.js,openclaw-server.js,core,infrastructure,ipc,tests,benchmarks,src}/**/*.js\"",
    "typecheck": "tsc --noEmit",
    "build": "electron-builder --win --x64",
    "build-portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/node": "^26.1.2",
    "electron": "^28.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.0",
    "prettier": "^3.3.0",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.asistente.personal",
    "productName": "Asistente Personal",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "files": [
      "main.js",
      "src/**/*",
      "assets/**/*",
      "models/**/*",
      "Models/**/*"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^11.0.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.12",
    "dotenv": "^17.4.2",
    "marked": "^9.1.6",
    "minimatch": "^10.2.0",
    "playwright": "^1.61.0",
    "sqlite-vec": "^0.1.9"
  },
  "overrides": {
    "tar": "7.5.21"
  }
}
