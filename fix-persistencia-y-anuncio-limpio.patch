+// Corta la respuesta del LLM en la última línea que reconoce como trigger
+// de acción ("Ejecutar:", "Voy a leer", "Voy a escribir") y descarta todo
+// lo que venga después. Si no encuentra ninguna, devuelve el texto tal cual
+// (no queremos tocar respuestas normales que no son anuncios de acción).
+function _sanitizePlanAnnouncement(response) {
+  const triggerRe = /^(Ejecutar:|Voy a leer|Voy a escribir)/i;
+  const lines = response.split('\n');
+  let lastTriggerIdx = -1;
+  lines.forEach((l, i) => { if (triggerRe.test(l.trim())) lastTriggerIdx = i; });
+  if (lastTriggerIdx === -1) return response;
+  return lines.slice(0, lastTriggerIdx + 1).join('\n').trim();
+}
